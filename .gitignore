# Runtime and build artefacts
.venv/
node_modules/
dist/

# The bundled Python runtime and its download cache are build outputs, not
# source. build/icon.png and build/entitlements.mac.plist are committed.
build/python-runtime/
build/cache/

# Caches kept inside the project so setup needs no system write access
.hf/
.pipcache/
.npmcache/
.electroncache/
.electron-builder-cache/
tmp/

# Local app data when running with WISP_DATA_DIR
.data/

# Python bytecode
__pycache__/
*.pyc

# Generated assets (assets/ and build/ are committed so the app runs before
# setup.sh; regenerate them any time with: npm run icons)

.DS_Store
*.log

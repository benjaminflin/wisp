<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs a JIT and writable-executable memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Wisp ships its own Python runtime and MLX's libmlx.dylib, none of which
       are signed by this team. Under the hardened runtime, library validation
       refuses to load code signed by anyone else, so the bundled interpreter
       would simply fail to start. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The app is not sandboxed, so the microphone is granted through TCC
       rather than this entitlement, but it is harmless to declare and needed
       if the app is ever sandboxed. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
